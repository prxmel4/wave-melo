# Discord bot token from the Discord Developer Portal. Never commit the real value.
DISCORD_TOKEN=replace_with_your_bot_token

# Optional guild ID for instant slash command registration while testing.
# Leave empty to register globally; global commands can take up to an hour to appear.
DISCORD_GUILD_ID=

# Lavalink server hostname or IP address. Defaults to 127.0.0.1.
# The bundled docker-compose.yml overrides this to the `lavalink` service
# name inside the bot container; this value is used for local `cargo run`.
LAVALINK_HOST=127.0.0.1

# Lavalink server port. Defaults to 2333.
LAVALINK_PORT=2333

# Lavalink authentication password.
# The default value 'youshallnotpass' is intended for local development only.
# Production deployments must replace this with a strong, unique password that matches
# the server's `lavalink.server.password` configuration.
LAVALINK_PASSWORD=youshallnotpass

# Whether to use TLS/WSS for the Lavalink connection. Defaults to false.
# Set to true when connecting to a remote Lavalink server over a public network.
LAVALINK_SECURE=false

# tracing-subscriber EnvFilter directive.
RUST_LOG=info,wavemelo=debug
